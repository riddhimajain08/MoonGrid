# Copy to .env and adjust if your DB credentials differ from the defaults
# in docker-compose.yml. Not required for local dev with docker compose —
# app/db.py already defaults to this exact URL. Note: port 5433, not 5432,
# to avoid clashing with a native Postgres install if you have one.
DATABASE_URL=postgresql+psycopg2://postgres:moongrid_dev@localhost:5433/moongrid
